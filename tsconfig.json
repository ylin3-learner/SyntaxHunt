{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
  
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["vitest/globals", "node", "vitest/config"]
  },
  "include": ["src", "tests", "vite.config.ts", "src/**/*.d.ts"]
}